# GeoHydroAI environment configuration
# Copy to .env and fill in real values. Never commit .env.

# ── Neo4j (required for graph build, dashboard, RAG) ─────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me            # must match docker-compose.yml

# ── External APIs ─────────────────────────────────────────────────────────────
GEONAMES_USER=your-geonames-username   # register at geonames.org (required for geo lookups)
OPEN_ALEX_EMAIL=you@example.org        # OpenAlex polite-pool contact (recommended)
OPEN_ALEX_API=                         # optional OpenAlex premium key
GEMINI_API_KEY=                        # optional; dashboard AI synthesis
HF_TOKEN=                              # optional; HuggingFace gated models

# ── LLM judge ─────────────────────────────────────────────────────────────────
OLLAMA_MODEL=mistral-nemo:12b
OLLAMA_URL=http://localhost:11434

# ── Stability-critical (always set when running Ray-based code) ──────────────
TOKENIZERS_PARALLELISM=false
RAYON_NUM_THREADS=1
OMP_NUM_THREADS=2

# PostgreSQL layer of truth (docker compose up -d postgres)
GHAI_PG_HOST=127.0.0.1
GHAI_PG_PORT=5433
GHAI_PG_DB=ghai
GHAI_PG_USER=ghai
GHAI_PG_PASSWORD=change-me
