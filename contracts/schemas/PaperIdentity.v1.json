{
  "$defs": {
    "PaperAlias": {
      "additionalProperties": false,
      "properties": {
        "alias_type": {
          "enum": [
            "doi",
            "doi_slug",
            "doi_slug_colon",
            "file_stem",
            "openalex_id",
            "pdf_sha256"
          ],
          "title": "Alias Type",
          "type": "string"
        },
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "source": {
          "description": "where the alias was observed, e.g. 'paper_json.metadata.doi'",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "alias_type",
        "alias",
        "source"
      ],
      "title": "PaperAlias",
      "type": "object"
    },
    "PaperFile": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "pdf",
            "tei",
            "paper_json",
            "normalized",
            "enriched",
            "sodb",
            "nougat_regions"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "description": "path relative to the repository root",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "truncated",
            "duplicate_copy"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "PaperFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One paper as the layer of truth knows it.",
  "properties": {
    "paper_id": {
      "description": "v1: the file stem used across data/",
      "minLength": 1,
      "title": "Paper Id",
      "type": "string"
    },
    "doi": {
      "anyOf": [
        {
          "pattern": "^10\\.\\d{4,9}/\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "year": {
      "anyOf": [
        {
          "maximum": 2100,
          "minimum": 1500,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Year"
    },
    "venue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Venue"
    },
    "openalex_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Openalex Id"
    },
    "identity_status": {
      "enum": [
        "ok",
        "no_doi",
        "title_doi_mismatch",
        "duplicate",
        "not_a_paper",
        "truncated_json"
      ],
      "title": "Identity Status",
      "type": "string"
    },
    "duplicate_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duplicate Of"
    },
    "aliases": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PaperAlias"
      },
      "title": "Aliases",
      "type": "array"
    },
    "files": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PaperFile"
      },
      "title": "Files",
      "type": "array"
    },
    "cohorts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Cohorts",
      "type": "array"
    }
  },
  "required": [
    "paper_id",
    "identity_status"
  ],
  "title": "PaperIdentity",
  "type": "object",
  "$id": "https://github.com/NikoriakViktot/geohydroai-knowledge-graph/contracts/PaperIdentity.v1.json"
}
