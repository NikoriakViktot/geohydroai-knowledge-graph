{
  "$defs": {
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Verbatim text of a corpus paper with where it is. Quote `text` exactly; never paraphrase it.",
      "properties": {
        "span_id": {
          "description": "sha256(paper_id + passage_id + text)[:16]",
          "title": "Span Id",
          "type": "string"
        },
        "paper": {
          "$ref": "#/$defs/PaperRef"
        },
        "passage_id": {
          "description": "'abstract', 's<i>[.s<j>].p<k>' (paragraph), 'fig_<k>' or 'tab_<k>'; stable for one TEI file",
          "title": "Passage Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "abstract",
            "paragraph",
            "figure",
            "table"
          ],
          "title": "Kind",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "section_n": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "section number as printed, e.g. '3.2'",
          "title": "Section N"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PDF page from GROBID coordinates; null when unknown",
          "title": "Page"
        },
        "char_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "offset of `text` in the passage text",
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "paper",
        "passage_id",
        "kind",
        "text"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "LLMUsage": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_sha256": {
          "title": "Prompt Sha256",
          "type": "string"
        },
        "tokens_in": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens In"
        },
        "tokens_out": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Out"
        },
        "cached": {
          "default": false,
          "title": "Cached",
          "type": "boolean"
        },
        "repair_count": {
          "default": 0,
          "title": "Repair Count",
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_sha256"
      ],
      "title": "LLMUsage",
      "type": "object"
    },
    "PaperRef": {
      "additionalProperties": false,
      "properties": {
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        },
        "identity_status": {
          "enum": [
            "ok",
            "no_doi",
            "title_doi_mismatch",
            "duplicate",
            "not_a_paper",
            "truncated_json"
          ],
          "title": "Identity Status",
          "type": "string"
        }
      },
      "required": [
        "paper_id",
        "identity_status"
      ],
      "title": "PaperRef",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Present in every successful response; record it with any result you use.",
      "properties": {
        "api_version": {
          "title": "Api Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Git Commit"
        },
        "corpus_manifest_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Corpus Manifest Id"
        },
        "collection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection"
        },
        "embedding_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Model"
        },
        "kb_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kb Version"
        },
        "identity_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Run Id"
        },
        "llm": {
          "anyOf": [
            {
              "$ref": "#/$defs/LLMUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "git_commit",
        "corpus_manifest_id",
        "generated_at"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "paper": {
      "$ref": "#/$defs/PaperRef"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/EvidenceSpan"
      },
      "title": "Spans",
      "type": "array"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    },
    "matched_passages": {
      "title": "Matched Passages",
      "type": "integer"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "paper",
    "spans",
    "truncated",
    "matched_passages",
    "provenance"
  ],
  "title": "TextResponse",
  "type": "object",
  "$id": "https://github.com/NikoriakViktot/geohydroai-knowledge-graph/contracts/TextResponse.v1.json"
}
