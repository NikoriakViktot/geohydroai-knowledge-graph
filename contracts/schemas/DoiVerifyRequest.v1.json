{
  "$defs": {
    "BibInput": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "echoed back; with project_id, a cite key to look up the DOI",
          "title": "Key"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "authors": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "BibTeX 'Family, G. and …', or a list",
          "title": "Authors"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'2024a' is read as 2024",
          "title": "Year"
        },
        "journal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Journal"
        },
        "volume": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume"
        },
        "issue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue"
        },
        "pages": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pages"
        },
        "bibtex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "one raw BibTeX entry instead of the fields",
          "title": "Bibtex"
        }
      },
      "title": "BibInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/BibInput"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "project_id": {
      "anyOf": [
        {
          "enum": [
            "floodstate-eo:paper3",
            "kakhovka-terrain:paper2",
            "swot-dnipro:paper1",
            "kakhovka-report:v1",
            "article1"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "lets entries without a DOI use their cite key",
      "title": "Project Id"
    },
    "refresh": {
      "default": false,
      "description": "ignore cached registry answers",
      "title": "Refresh",
      "type": "boolean"
    }
  },
  "required": [
    "entries"
  ],
  "title": "DoiVerifyRequest",
  "type": "object",
  "$id": "https://github.com/NikoriakViktot/geohydroai-knowledge-graph/contracts/DoiVerifyRequest.v1.json"
}
