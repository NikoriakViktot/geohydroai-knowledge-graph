{
  "$defs": {
    "LLMUsage": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_sha256": {
          "title": "Prompt Sha256",
          "type": "string"
        },
        "tokens_in": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens In"
        },
        "tokens_out": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Out"
        },
        "cached": {
          "default": false,
          "title": "Cached",
          "type": "boolean"
        },
        "repair_count": {
          "default": 0,
          "title": "Repair Count",
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_sha256"
      ],
      "title": "LLMUsage",
      "type": "object"
    },
    "ManuscriptCitation": {
      "additionalProperties": false,
      "properties": {
        "cite_text": {
          "description": "as written, e.g. 'Johnson et al. (2019)' or '(Bates 2022)'",
          "title": "Cite Text",
          "type": "string"
        },
        "authors": {
          "title": "Authors",
          "type": "string"
        },
        "year": {
          "description": "with its suffix, e.g. 2024a",
          "title": "Year",
          "type": "string"
        },
        "status": {
          "enum": [
            "resolved",
            "ambiguous",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        },
        "cite_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cite Key"
        },
        "candidates": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidates",
          "type": "array"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "sentence": {
          "title": "Sentence",
          "type": "string"
        },
        "line": {
          "title": "Line",
          "type": "integer"
        },
        "quoted": {
          "default": [],
          "description": "words in quotation marks in the sentence",
          "items": {
            "type": "string"
          },
          "title": "Quoted",
          "type": "array"
        }
      },
      "required": [
        "cite_text",
        "authors",
        "year",
        "status",
        "sentence",
        "line"
      ],
      "title": "ManuscriptCitation",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Present in every successful response; record it with any result you use.",
      "properties": {
        "api_version": {
          "title": "Api Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Git Commit"
        },
        "corpus_manifest_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Corpus Manifest Id"
        },
        "collection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection"
        },
        "embedding_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Model"
        },
        "kb_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kb Version"
        },
        "identity_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Run Id"
        },
        "llm": {
          "anyOf": [
            {
              "$ref": "#/$defs/LLMUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "git_commit",
        "corpus_manifest_id",
        "generated_at"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "occurrences": {
      "items": {
        "$ref": "#/$defs/ManuscriptCitation"
      },
      "title": "Occurrences",
      "type": "array"
    },
    "missing_keys": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Missing Keys",
      "type": "array"
    },
    "uncited_entries": {
      "items": {
        "type": "string"
      },
      "title": "Uncited Entries",
      "type": "array"
    },
    "summary": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Summary",
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "occurrences",
    "missing_keys",
    "uncited_entries",
    "summary",
    "provenance"
  ],
  "title": "ManuscriptCitationsResponse",
  "type": "object",
  "$id": "https://github.com/NikoriakViktot/geohydroai-knowledge-graph/contracts/ManuscriptCitationsResponse.v1.json"
}
