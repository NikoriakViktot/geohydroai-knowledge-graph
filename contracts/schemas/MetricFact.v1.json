{
  "$defs": {
    "FactEvidence": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the sentence, verbatim (text facts)",
          "title": "Text"
        },
        "passage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passage Id"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "table_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Label"
        },
        "col_header": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Col Header"
        },
        "row_context": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Row Context",
          "type": "array"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        }
      },
      "title": "FactEvidence",
      "type": "object"
    },
    "PaperRef": {
      "additionalProperties": false,
      "properties": {
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        },
        "identity_status": {
          "enum": [
            "ok",
            "no_doi",
            "title_doi_mismatch",
            "duplicate",
            "not_a_paper",
            "truncated_json"
          ],
          "title": "Identity Status",
          "type": "string"
        }
      },
      "required": [
        "paper_id",
        "identity_status"
      ],
      "title": "PaperRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "metric": {
      "description": "canonical id, e.g. metric.nse",
      "title": "Metric",
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "value": {
      "description": "as a ratio for bounded metrics read from a percentage (94.2 % → 0.942)",
      "title": "Value",
      "type": "number"
    },
    "value_hi": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "upper end when the paper gives a range",
      "title": "Value Hi"
    },
    "raw_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Value"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "a recognised unit, else null",
      "title": "Unit"
    },
    "unit_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "unrecognised text from the table column",
      "title": "Unit Raw"
    },
    "qualifier": {
      "anyOf": [
        {
          "enum": [
            "range",
            ">",
            "<",
            "≥",
            "≤",
            "≈"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "'>' etc.: an inequality, usually a criterion rather than a result",
      "title": "Qualifier"
    },
    "range_verdict": {
      "enum": [
        "ok",
        "suspect",
        "unknown_metric"
      ],
      "title": "Range Verdict",
      "type": "string"
    },
    "source": {
      "enum": [
        "text",
        "table"
      ],
      "title": "Source",
      "type": "string"
    },
    "fact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fact Id"
    },
    "paper": {
      "anyOf": [
        {
          "$ref": "#/$defs/PaperRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "$ref": "#/$defs/FactEvidence"
    }
  },
  "required": [
    "metric",
    "value",
    "range_verdict",
    "source",
    "evidence"
  ],
  "title": "MetricFact",
  "type": "object",
  "$id": "https://github.com/NikoriakViktot/geohydroai-knowledge-graph/contracts/MetricFact.v1.json"
}
