{
  "$defs": {
    "LLMUsage": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_sha256": {
          "title": "Prompt Sha256",
          "type": "string"
        },
        "tokens_in": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens In"
        },
        "tokens_out": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Out"
        },
        "cached": {
          "default": false,
          "title": "Cached",
          "type": "boolean"
        },
        "repair_count": {
          "default": 0,
          "title": "Repair Count",
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_sha256"
      ],
      "title": "LLMUsage",
      "type": "object"
    },
    "PaperRef": {
      "additionalProperties": false,
      "properties": {
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        },
        "identity_status": {
          "enum": [
            "ok",
            "no_doi",
            "title_doi_mismatch",
            "duplicate",
            "not_a_paper",
            "truncated_json"
          ],
          "title": "Identity Status",
          "type": "string"
        }
      },
      "required": [
        "paper_id",
        "identity_status"
      ],
      "title": "PaperRef",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Present in every successful response; record it with any result you use.",
      "properties": {
        "api_version": {
          "title": "Api Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Git Commit"
        },
        "corpus_manifest_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Corpus Manifest Id"
        },
        "collection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection"
        },
        "embedding_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Model"
        },
        "kb_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kb Version"
        },
        "identity_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Run Id"
        },
        "llm": {
          "anyOf": [
            {
              "$ref": "#/$defs/LLMUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "git_commit",
        "corpus_manifest_id",
        "generated_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ReferenceEntry": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "description": "position in the paper's reference list, from 1",
          "title": "N",
          "type": "integer"
        },
        "xml_id": {
          "description": "TEI id; the target of in-text citation markers",
          "title": "Xml Id",
          "type": "string"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the reference as printed, when GROBID kept it",
          "title": "Raw"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "authors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "normalised; as parsed by GROBID, not verified",
          "title": "Doi"
        },
        "cited_in_text": {
          "description": "number of in-text citation markers that point at this entry",
          "title": "Cited In Text",
          "type": "integer"
        },
        "in_corpus": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaperRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "match": {
          "anyOf": [
            {
              "enum": [
                "doi",
                "title"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "how `in_corpus` was found",
          "title": "Match"
        }
      },
      "required": [
        "n",
        "xml_id",
        "cited_in_text"
      ],
      "title": "ReferenceEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "paper": {
      "$ref": "#/$defs/PaperRef"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/ReferenceEntry"
      },
      "title": "References",
      "type": "array"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "paper",
    "references",
    "counts",
    "provenance"
  ],
  "title": "ReferencesResponse",
  "type": "object",
  "$id": "https://github.com/NikoriakViktot/geohydroai-knowledge-graph/contracts/ReferencesResponse.v1.json"
}
