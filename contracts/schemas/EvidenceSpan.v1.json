{
  "$defs": {
    "PaperRef": {
      "additionalProperties": false,
      "properties": {
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        },
        "identity_status": {
          "enum": [
            "ok",
            "no_doi",
            "title_doi_mismatch",
            "duplicate",
            "not_a_paper",
            "truncated_json"
          ],
          "title": "Identity Status",
          "type": "string"
        }
      },
      "required": [
        "paper_id",
        "identity_status"
      ],
      "title": "PaperRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Verbatim text of a corpus paper with where it is. Quote `text` exactly; never paraphrase it.",
  "properties": {
    "span_id": {
      "description": "sha256(paper_id + passage_id + text)[:16]",
      "title": "Span Id",
      "type": "string"
    },
    "paper": {
      "$ref": "#/$defs/PaperRef"
    },
    "passage_id": {
      "description": "'abstract', 's<i>[.s<j>].p<k>' (paragraph), 'fig_<k>' or 'tab_<k>'; stable for one TEI file",
      "title": "Passage Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "abstract",
        "paragraph",
        "figure",
        "table"
      ],
      "title": "Kind",
      "type": "string"
    },
    "section": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Section"
    },
    "section_n": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "section number as printed, e.g. '3.2'",
      "title": "Section N"
    },
    "page": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "PDF page from GROBID coordinates; null when unknown",
      "title": "Page"
    },
    "char_start": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "offset of `text` in the passage text",
      "title": "Char Start"
    },
    "char_end": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Char End"
    },
    "chunk_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chunk Id"
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "span_id",
    "paper",
    "passage_id",
    "kind",
    "text"
  ],
  "title": "EvidenceSpan",
  "type": "object",
  "$id": "https://github.com/NikoriakViktot/geohydroai-knowledge-graph/contracts/EvidenceSpan.v1.json"
}
