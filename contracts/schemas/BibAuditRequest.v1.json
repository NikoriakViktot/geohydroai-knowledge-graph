{
  "additionalProperties": false,
  "properties": {
    "bibtex": {
      "maxLength": 5000000,
      "minLength": 1,
      "title": "Bibtex",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*(:[a-z0-9][a-z0-9-]*)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "search_missing": {
      "default": true,
      "description": "look up DOIs for entries that have none (Crossref)",
      "title": "Search Missing",
      "type": "boolean"
    }
  },
  "required": [
    "bibtex"
  ],
  "title": "BibAuditRequest",
  "type": "object",
  "$id": "https://github.com/NikoriakViktot/geohydroai-knowledge-graph/contracts/BibAuditRequest.v1.json"
}
