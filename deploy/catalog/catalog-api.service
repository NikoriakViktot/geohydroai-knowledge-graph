# /etc/systemd/system/catalog-api.service
[Unit]
Description=GeoHydroAI paper catalog API (read-only cards)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=catalog
Group=catalog
WorkingDirectory=/srv/catalog/app
# CATALOG_API_KEY_HASHES lives here (mode 600); empty file = open API (private network only)
EnvironmentFile=-/srv/catalog/catalog.env
Environment=CATALOG_SNAPSHOT_DIR=/srv/catalog/current
ExecStart=/srv/catalog/venv/bin/uvicorn src.catalog.api:app --host 127.0.0.1 --port 8095 --workers 2 --proxy-headers
Restart=on-failure
RestartSec=3
# hardening: the service only reads the app and the snapshot
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/srv/catalog
MemoryMax=1G

[Install]
WantedBy=multi-user.target
